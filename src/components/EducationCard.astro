---
import type { Education } from '../types/content';
import Disclosure from './ui/Disclosure.astro';
interface Props {
  school: Education;
}
const { school } = Astro.props;
---

<article class="school-card">
  <div class="school-brand">
    <img {...school.logo} loading="lazy" />
  </div>
  <p class="date">{school.dates}</p>
  <h3>{school.name}</h3>
  <p class="qualification">{school.qualification}</p>
  <dl class="academic-result">
    <dt>{school.result.label}</dt>
    <dd>{school.result.value}</dd>
  </dl>
  {school.awards.length > 0 && (
    <>
      <h4>Awards &amp; scholarships</h4>
      <ul class="school-awards">
        {school.awards.map((award) => (
          <li>{award}</li>
        ))}
      </ul>
    </>
  )}
  {school.activities.items.length > 0 && (
    <Disclosure label="Activities" class="school-activities">
      {school.activities.group && (
        <div class="hall-heading">
          {school.activities.logo && (
            <img
              class="hall-crest"
              src={school.activities.logo}
              alt={`${school.activities.group} crest`}
              width="459"
              height="504"
              loading="lazy"
            />
          )}
          <h4>{school.activities.group}</h4>
        </div>
      )}
      <ul>
        {school.activities.items.map((activity) => (
          <li>{activity}</li>
        ))}
      </ul>
    </Disclosure>
  )}
  {school.exchange && (
    <div class="exchange">
      <img
        src={school.exchange.logo}
        alt={school.exchange.name}
        width="50"
        height="50"
        loading="lazy"
      />
      <div>
        <p class="date">{school.exchange.dates}</p>
        <h4>{school.exchange.name}</h4>
        <p>{school.exchange.description}</p>
      </div>
    </div>
  )}
</article>
