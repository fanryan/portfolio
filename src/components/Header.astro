---
const links = [
  { label: 'Work', href: '/#experience' },
  { label: 'Education', href: '/#education' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Tech Stack', href: '/#stack' },
  { label: 'Life', href: '/#about' },
];
---

<header class="header">
  <a class="wordmark" href="/#home" aria-label="Ryan Fan, home">
    RYAN
    <br />
    FAN<span>.</span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a class="nav-contact" href="/#contact">
      LET’S TALK{' '}
      <span class="text-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  </nav>
  <details class="mobile-menu">
    <summary>
      Menu <span>+</span>
    </summary>
    <nav aria-label="Mobile navigation">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/#contact">
        Let’s talk{' '}
        <span class="text-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </nav>
  </details>
</header>
<script>
  const header = document.querySelector('.header') as HTMLElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const phase = (progress: number, start: number, end: number) =>
    clamp((progress - start) / (end - start));
  const ease = (value: number) => value * value * (3 - 2 * value);
  const updateHeader = () => {
    const offset = hero ? hero.offsetHeight * 0.8 : 700;
    const progress = clamp(window.scrollY / offset);
    const mask = ease(phase(progress, 0.04, 0.23));
    const alpha = 0.08 + mask * 0.72;
    if (header) {
      header.style.setProperty('--header-alpha', alpha.toFixed(3));
      header.classList.toggle('scrolled', progress > 0.05);
    }
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
  document
    .querySelectorAll('.mobile-menu a')
    .forEach((link) =>
      link.addEventListener('click', () =>
        document.querySelector('.mobile-menu')?.removeAttribute('open'),
      ),
    );
</script>
