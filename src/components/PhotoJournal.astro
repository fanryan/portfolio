---
import { photos as defaultPhotos } from '../data/photos';
import type { Photo } from '../types/content';
interface Props {
  photos?: Photo[];
}
const { photos = defaultPhotos } = Astro.props;
---

<div class="photo-journal">
  <div class="journal">
    <div class="journal-bar">
      <span class="eyebrow">
        PERSONAL PHOTOS{' '}
        <span class="photo-total">
          / {String(photos.length).padStart(2, '0')}
        </span>
      </span>
    </div>
    <div
      class="journal-strip"
      tabindex="0"
      role="region"
      aria-label="Personal photo gallery"
    >
      {photos.map((photo, i) => (
        <figure
          class:list={[
            'journal-photo',
            { landscape: photo.width > photo.height },
          ]}
        >
          <div class="photo-label">
            <span>{photo.category}</span>
            <span>{String(i + 1).padStart(2, '0')}</span>
          </div>
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            style={`object-position:${photo.position}`}
          />
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</div>
