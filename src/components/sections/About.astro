---
import { about, exchangeCountries } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import PhotoJournal from '../PhotoJournal.astro';
---

<section id="about" class="section about">
  <SectionHeading number="05" title="Photo notes" />
  <div class="about-intro">
    <p>{about.description}</p>
  </div>
  <div class="travel-facts" aria-label="Travel highlights">
    <span class="travel-fact-label">Fun fact!</span>
    <span class="travel-fact-copy">I’ve visited</span>
    <strong>39</strong>
    <span class="travel-fact-copy">countries,</span>
    <details class="exchange-countries">
      <summary>
        <strong>31</strong>
        <span>while on exchange</span>
      </summary>
      <div
        class="country-popover"
        aria-label="Countries visited during exchange"
      >
        <p>Visited during exchange</p>
        <ul>
          {exchangeCountries.map((country) => (
            <li title={country.name} aria-label={country.name}>
              <img src={`/images/flags/${country.code}.svg`} alt="" />
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>
  <PhotoJournal />
</section>
<script>
  const exchangeCountries = document.querySelector<HTMLDetailsElement>(
    '.exchange-countries',
  );

  exchangeCountries?.addEventListener('mouseenter', () => {
    exchangeCountries.open = true;
  });
  exchangeCountries?.addEventListener('mouseleave', () => {
    exchangeCountries.open = false;
  });
</script>
