---
import { site, contact } from '../../data/site';
---

<section class="contact" id="contact">
  <div>
    <p class="eyebrow">GET IN TOUCH</p>
    <h2>
      {contact.heading}
      <span>.</span>
    </h2>
    <p>{contact.description}</p>
  </div>
  <a class="button sky" href={`mailto:${site.email}`}>
    Email me <span aria-hidden="true">↗</span>
  </a>
</section>
