---
import { site, contact } from '../../data/site';
---

<section class="contact" id="contact">
  <div>
    <h2>{contact.heading}</h2>
    <p>{contact.description}</p>
  </div>
  <a class="button sky" href={`mailto:${site.email}`}>
    Email Ryan{' '}
    <span class="text-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</section>
