---
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import Tags from '../ui/Tags.astro';
---

<section id="projects" class="section">
  <SectionHeading
    number="03"
    title="Projects"
    note={
      <>
        All repositories{' '}
        <span class="text-arrow" aria-hidden="true">
          ↗
        </span>
      </>
    }
    href={site.github}
  />
  <div class="project-carousel" data-project-carousel>
    <div
      class="project-viewport"
      tabindex="0"
      aria-label="Projects carousel. Swipe or use the arrow buttons to browse projects."
    >
      <div class="project-track">
        {projects.map((project, index) => (
          <article
            class="project"
            data-tone={project.tone}
            aria-label={`Project ${index + 1} of ${projects.length}`}
          >
            {project.preview && project.media ? (
              <a
                class="project-screenshot"
                href={
                  project.appUrl ?? `/projects/${project.name.toLowerCase()}/`
                }
                target={project.appUrl ? '_blank' : undefined}
                rel={project.appUrl ? 'noopener noreferrer' : undefined}
                aria-label={`Explore ${project.name}`}
              >
                <span class="project-screenshot-frame">
                  <img
                    src={project.media.thumbnail}
                    alt={project.media.alt}
                    width={project.media.width}
                    height={project.media.height}
                    loading="lazy"
                  />
                </span>
              </a>
            ) : (
              <div class="project-visual" aria-hidden="true">
                <span class="project-number">
                  {String(index + 1).padStart(2, '0')} /
                </span>
                <div class="flow">
                  {project.flow.map((step, i) => (
                    <>
                      <span>{step}</span>
                      {i < project.flow.length - 1 && <b>↓</b>}
                    </>
                  ))}
                </div>
              </div>
            )}
            <div class="project-content">
              <p class="eyebrow">{project.label}</p>
              <h3>{project.name}</h3>
              <p>{project.summary}</p>
              <Tags items={project.stack} />
              <a
                class="project-detail-link"
                href={`/projects/${project.name.toLowerCase()}/`}
              >
                View project{' '}
                <span class="text-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="project-secondary-links">
                <a
                  class="repo-link"
                  href={project.repository}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View source{' '}
                  <span class="text-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
                {project.appUrl && (
                  <a
                    class="app-link"
                    href={project.appUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open NUSpot{' '}
                    <span class="text-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="project-carousel-footer">
      <div class="project-carousel-controls">
        <button
          type="button"
          data-project-previous
          aria-label="Previous project"
        >
          ←
        </button>
        <button type="button" data-project-next aria-label="Next project">
          →
        </button>
      </div>
    </div>
  </div>
</section>
<script>
  import '../../scripts/project-carousel';
</script>
