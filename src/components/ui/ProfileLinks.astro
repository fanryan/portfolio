---
import { site } from '../../data/site';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const links = [
  { label: 'GitHub ↗', href: site.github },
  { label: 'LinkedIn ↗', href: site.linkedin },
];
---

{links.map((link) => (
  <a class={className} href={link.href}>
    {link.label}
  </a>
))}
