---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import {experience, projects} from '../data/content';
import PhotoJournal from '../components/PhotoJournal.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Ryan Fan — Software Engineering Portfolio</title>
<meta name="description" content="Ryan Fan, Business Analytics student at NUS focused on software engineering. Backend systems, data infrastructure, AI tooling, and a little life outside the laptop."/>
<meta name="theme-color" content="#234B3B"/>
<meta property="og:title" content="Ryan Fan — Software Engineering Portfolio"/><meta property="og:description" content="Backend systems, data infrastructure and AI tooling. Explore my work, experience and projects."/><meta property="og:type" content="website"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><a class="wordmark" href="#home">Ryan Fan<span>.</span></a><nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="#about">About</a><a class="nav-contact" href="mailto:fanryan03@gmail.com">Say hello <span aria-hidden="true">↗</span></a></nav></header>
<main id="main">
<section class="hero" id="home" aria-labelledby="intro-title"><div class="hero-copy"><p class="eyebrow">SOFTWARE ENGINEERING / NUS</p><p class="hello">Hey, I’m</p><h1 id="intro-title">Ryan Fan<span>.</span></h1><p class="intro">A Business Analytics student at NUS, focused on software engineering.</p><p class="hero-description">My work spans backend systems, data infrastructure and AI tooling. Away from my laptop, I’m usually playing sports, getting outdoors or looking for my next travel destination.</p><div class="hero-links"><a class="button sky" href="#experience">Explore my work <span aria-hidden="true">↓</span></a><a class="text-link" href="/Fan_Ryan_Resume.pdf" download="Fan_Ryan_Resume.pdf">Résumé ↓</a><a class="text-link" href="https://github.com/fanryan">GitHub ↗</a><a class="text-link" href="https://linkedin.com/in/fanryan">LinkedIn ↗</a></div></div><figure class="portrait"><img src="/images/photo5.jpg" alt="Ryan in a white shirt outside an arched entrance" width="780" height="1041" fetchpriority="high"/><figcaption><span>RYAN FAN</span><span>Nice to meet you.</span></figcaption></figure><div class="hero-bottom"><span>BACKEND SYSTEMS</span><span>DATA INFRASTRUCTURE</span><span>AI TOOLING</span></div></section>
<div class="page-content">
<section id="experience" class="section"><div class="section-heading"><span class="index">01</span><h2>Experience</h2><span class="section-note">Where I’ve been working</span></div><div class="experience-list">{experience.map((job,i)=><article class:list={['experience-row',{'incoming':i===0}]}><div class="experience-meta"><span class="date">{job.dates}</span><span class="timeline-dot" aria-hidden="true"></span><img class:list={['company-logo',job.logo]} src={`/images/${job.logo}.png`} alt={job.company} loading="lazy" width="160" height="65"/></div><div class="experience-body"><div class="role-heading"><h3>{job.role}</h3>{i===0&&<span class="badge">Incoming</span>}</div><p class="sub-label">{job.label}</p><p>{job.summary}</p>{job.details.length>0&&<details><summary>More about my work <span aria-hidden="true">+</span></summary><ul>{job.details.map(detail=><li>{detail}</li>)}</ul><div class="tags">{job.stack.map(tag=><span>{tag}</span>)}</div></details>}</div></article>)}</div></section>
<section id="projects" class="section"><div class="section-heading"><span class="index">02</span><h2>Selected projects</h2><a class="section-note text-link" href="https://github.com/fanryan">All repositories ↗</a></div><div class="project-grid">{projects.map(project=><article class="project"><div class="project-visual" aria-hidden="true"><span class="project-number">{project.number} /</span><div class="flow">{project.flow.map((step,i)=><><span>{step}</span>{i<2&&<b>↓</b>}</>)}</div></div><div class="project-content"><p class="eyebrow">{project.label}</p><h3>{project.name}</h3><p>{project.summary}</p><div class="tags">{project.stack.map(tag=><span>{tag}</span>)}</div><details><summary>What I worked on <span aria-hidden="true">+</span></summary><ul>{project.details.map(detail=><li>{detail}</li>)}</ul></details><a class="repo-link" href={`https://github.com/fanryan/${project.slug}`}>View GitHub <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
<section id="education" class="section"><div class="section-heading"><span class="index">03</span><h2>Education</h2></div>
<div class="school-grid">
<article class="school-card"><div class="school-brand"><img src="/images/nus.png" alt="NUS School of Computing" width="230" height="46" loading="lazy"/></div><p class="date">AUG 2024 — MAY 2028 · EXPECTED</p><h3>National University of Singapore</h3><p class="qualification">BSc in Business Analytics</p><dl class="academic-result"><dt>GPA</dt><dd>4.81 / 5.00</dd></dl><h4>Awards &amp; scholarships</h4><ul class="school-awards"><li>SG Digital Scholarship</li><li>Top Students for Application Systems Development (BT3103)</li></ul>
<details class="school-activities"><summary>Activities <span aria-hidden="true">+</span></summary><div class="hall-heading"><img class="hall-crest" src="/images/raffles-hall.png" alt="Raffles Hall crest" width="459" height="504" loading="lazy"/><h4>Raffles Hall</h4></div><ul><li>Floorball Captain</li><li>Sports Management Committee Chairperson</li><li>Track member</li><li>Road Relay member</li><li>Block Committee member</li><li>Secretariat member</li><li>RHDevelopers member</li><li>Rag and Flag (Floats) member</li></ul></details>
<div class="exchange"><img src="/images/aarhus.png" alt="Aarhus University" width="50" height="50" loading="lazy"/><div><p class="date">AUG — DEC 2026 · EXCHANGE</p><h4>Aarhus University</h4><p>Economics and Business Administration, bachelor’s level. Student Exchange Programme through NUS.</p></div></div></article>
<article class="school-card"><div class="school-brand"><img src="/images/hci.png" alt="Hwa Chong Institution" width="190" height="68" loading="lazy"/></div><p class="date">2016 — 2021</p><h3>Hwa Chong Institution</h3><p class="qualification">Singapore-Cambridge GCE Advanced Level</p><dl class="academic-result"><dt>Rank points</dt><dd>88.75</dd></dl><h4>Awards &amp; scholarships</h4><ul class="school-awards"><li>Edusave Scholarship for Independent Schools</li></ul><details class="school-activities"><summary>Activities <span aria-hidden="true">+</span></summary><ul><li>Secretary · Project Hear Me Out</li><li>Patrol Leader · Hwa Chong Scout Group</li><li>Member · Hwa Chong Floorball</li></ul></details></article>
</div></section>
<section id="about" class="section about"><div class="section-heading"><span class="index">04</span><h2>After hours</h2><span class="section-note">A few photos along the way</span></div><div class="about-intro"><p>Floorball, bouldering and time outdoors take up a fair bit of my week. I love travelling, and I’m often looking for somewhere new to explore.</p><p>On race weekends, I’m cheering for Leclerc and Ferrari.</p></div><PhotoJournal /></section>
</div>
<section class="contact" id="contact"><div><p class="eyebrow">GET IN TOUCH</p><h2>Let’s talk<span>.</span></h2><p>For opportunities, questions about my projects or a conversation about software, feel free to reach out.</p></div><a class="button sky" href="mailto:fanryan03@gmail.com">Email me <span aria-hidden="true">↗</span></a></section>
</main><footer><span>© {new Date().getFullYear()} Ryan Fan</span><div><a href="https://github.com/fanryan">GitHub ↗</a><a href="https://linkedin.com/in/fanryan">LinkedIn ↗</a><a href="/Fan_Ryan_Resume.pdf" download="Fan_Ryan_Resume.pdf">Résumé ↓</a><a href="#home">Back to top ↑</a></div></footer>
</body></html>
