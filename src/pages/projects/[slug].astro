---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import Tags from '../../components/ui/Tags.astro';
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.name.toLowerCase() },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<BaseLayout title={`${project.name} — Ryan Fan`} description={project.summary}>
  <article class="project-page section">
    <a class="back-link" href="/#projects">
      ← All projects
    </a>
    <p class="eyebrow">{project.label}</p>
    <h1>{project.name}</h1>
    <p class="project-page-intro">{project.summary}</p>
    <Tags items={project.stack} />
    <div class="project-page-flow" aria-label="Workflow">
      {project.flow.map((step, index) => (
        <span>
          <small>0{index + 1}</small>
          {step}
        </span>
      ))}
    </div>
    {project.media && (
      <section class="project-media" aria-label={project.media.title}>
        <h2>{project.media.title}</h2>
        {!project.preview && (
          <p class="media-context">
            Original design whiteboard · reviewed against source code on 10
            October 2026. Read the implementation notes below alongside the
            diagram.
          </p>
        )}
        <figure>
          <a
            href={project.media.src}
            target="_blank"
            rel="noopener"
            aria-label={`Open ${project.name} image full size in a new tab`}
          >
            <img
              src={project.media.thumbnail}
              alt={project.media.alt}
              width={project.media.width}
              height={project.media.height}
              loading="lazy"
            />
          </a>
          <figcaption>
            <a href={project.media.src} target="_blank" rel="noopener">
              Open full-size image ↗
            </a>
          </figcaption>
        </figure>
        <p class="media-context">
          Open the image to zoom in on smaller screens.
        </p>
        <ul class="project-contributions">
          {project.media.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </section>
    )}
    <h2>What I worked on</h2>
    <ul class="project-contributions">
      {project.details.map((detail) => (
        <li>{detail}</li>
      ))}
    </ul>
    <a class="button" href={project.repository}>
      Explore the code ↗
    </a>
  </article>
</BaseLayout>
